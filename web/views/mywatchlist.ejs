<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Watchlist</title>
    <link rel="stylesheet" href="../CSS_Files/mywatchlist.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body style="background-color: #121212;">
    <div class="navBar">
        <div class="logo">
            <a href="/home"><img src="../images/MOVU_LOGO.PNG" width="100px" height="40px"></a>
        </div>
        <div class="menu">
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                  Menu
                </button>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="/mywatchlist">My Watchlist</a></li>
                  <li><a class="dropdown-item" href="/myratings">My Ratings</a></li>
                </ul>
            </div>
            <div id="searching">
                <div class="search_bar">
                    <input placeholder="Search MOVU" onkeyup="captureString()" id="inputField" aria-label="Search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
                <div id="search_result"></div>
            </div>
            <a class="anchor_change" href="/MovU/web/home.html">Home</a>
            <a class="anchor_change" href="/MovU/web/AboutUs.html">About</a>
            <div class="profile">
                <i class="fa-regular fa-user"></i>
                <a class="anchor_change" href="#"><% if (user) { %>
                    <span><%= user.UserName %></span>
                <% } else { %>
                    <span>Guest</span>
                <% } %></a>
            </div>
        </div>
    </div>

    <div class="movies">
        <div class="banner">
            <div class="red_marker"></div>
            <h1>Your Watchlist</h1>
            <div class="red_marker"></div>
        </div>
        <div class="movieContainer">
            <% if (movies.length > 0) { %>
                <% movies.forEach(movie => { %>
                    <div class="box">
                        <img src="https://image.tmdb.org/t/p/w500/<%= movie.poster_path %>" alt="<%= movie.title %>" class="image">
                        <div class="details">
                            <h2><%= movie.title %></h2>
                            <p><%= movie.overview %></p>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No movies in your watchlist.</p>
            <% } %>
        </div>
    </div>

    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
